{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "afd_profile_id": {
            "type": "string",
            "metadata": {
                "description": "The ID of the Azure Front Door profile"
            }
        },
        "afd_endpoint_id": {
            "type": "string",
            "metadata": {
                "description": "The ID of the Azure Front Door endpoint"
            }
        },
        "selected_load_balancing": {
            "type": "string",
            "metadata": {
                "description": "The selected load balancing percentage (e.g., SiteA50SiteB50)"
            }
        },
        "afd_rulesets": {
            "type": "array",
            "metadata": {
                "description": "Array of all rulesets in the Front Door profile (with id and name properties)"
            }
        },
        "route_names": {
            "type": "array",
            "metadata": {
                "description": "Array of route names (same order as all_route_ids)"
            }
        },
        "route_originGroups": {
            "type": "array",
            "metadata": {
                "description": "The list of origin groups for the routes"
            }
        },
        "route_customDomains": {
            "type": "array",
            "metadata": {
                "description": "The list of custom domains for the routes"
            }
        },
        "route_patterns": { "type": "array" },
        "route_protocols": { "type": "array" },
        "route_httpsRedirect": { "type": "array" },
        "route_forwardingProto": { "type": "array" },
        "route_enabledState": { "type": "array" },
        "route_linkToDefaultDomain": { "type": "array" },
        "route_cacheConfig": { "type": "array" },
        "route_currentRuleSets": {
            "type": "array",
            "metadata": {
                "description": "Current ruleset associations for each route (array of arrays)"
            }
        },
        "all_route_ids": {
            "type": "array",
            "metadata": {
                "description": "IDs of all routes (index aligns with originGroups / customDomains)"
            }
        }
    },
    "variables": {
        "afd_profile_name": "[last(split(parameters('afd_profile_id'), '/'))]",
        "afd_endpoint_name": "[last(split(parameters('afd_endpoint_id'), '/'))]",
        
        "filtered_route_indexes": "[filter(range(0, length(parameters('all_route_ids'))), lambda('i', startsWith(parameters('route_names')[lambdaVariables('i')], 'route-to-')))]",
        "filtered_route_ids": "[map(variables('filtered_route_indexes'), lambda('i', parameters('all_route_ids')[lambdaVariables('i')]))]",
        
        "route_identifiers": "[map(variables('filtered_route_indexes'), lambda('i', if(equals(parameters('route_names')[lambdaVariables('i')], 'route-to-azure'), 'Azure', if(equals(parameters('route_names')[lambdaVariables('i')], 'route-to-onprem'), 'OnPrem', concat(toUpper(substring(parameters('route_names')[lambdaVariables('i')], 9, 1)), substring(parameters('route_names')[lambdaVariables('i')], 10))))))]",
        
        "processedRuleSets": "[map(variables('filtered_route_indexes'), lambda('routeIdx', map(parameters('route_currentRuleSets')[lambdaVariables('routeIdx')], lambda('rs', if(startsWith(last(split(lambdaVariables('rs').id, '/')), 'Bilanciamento'), createObject('id', first(map(filter(parameters('afd_rulesets'), lambda('ruleset', equals(toLower(lambdaVariables('ruleset').name), toLower(concat('Bilanciamento', variables('route_identifiers')[indexOf(variables('filtered_route_indexes'), lambdaVariables('routeIdx'))], parameters('selected_load_balancing')))))), lambda('ruleset', lambdaVariables('ruleset').id)))), lambdaVariables('rs'))))))]"
    },
    "resources": [
        {
            "type": "Microsoft.Cdn/profiles/afdendpoints",
            "apiVersion": "2025-04-15",
            "name": "[concat(variables('afd_profile_name'), '/', variables('afd_endpoint_name'))]",
            "location": "global"
        },
        {
            "type": "Microsoft.Cdn/profiles/afdendpoints/routes",
            "apiVersion": "2025-04-15",
            "name": "[concat(variables('afd_profile_name'), '/', variables('afd_endpoint_name'), '/', last(split(variables('filtered_route_ids')[copyIndex()], '/')))]",
            "copy": {
                "name": "routeAssociationLoop",
                "count": "[length(variables('filtered_route_ids'))]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Cdn/profiles/afdendpoints', variables('afd_profile_name'), variables('afd_endpoint_name'))]"
            ],
            "properties": {
                "originGroup": {
                    "id": "[parameters('route_originGroups')[variables('filtered_route_indexes')[copyIndex()]]]"
                },
                "customDomains": "[parameters('route_customDomains')[variables('filtered_route_indexes')[copyIndex()]]]",
                "patternsToMatch": "[parameters('route_patterns')[variables('filtered_route_indexes')[copyIndex()]]]",
                "supportedProtocols": "[parameters('route_protocols')[variables('filtered_route_indexes')[copyIndex()]]]",
                "httpsRedirect": "[parameters('route_httpsRedirect')[variables('filtered_route_indexes')[copyIndex()]]]",
                "forwardingProtocol": "[parameters('route_forwardingProto')[variables('filtered_route_indexes')[copyIndex()]]]",
                "enabledState": "[parameters('route_enabledState')[variables('filtered_route_indexes')[copyIndex()]]]",
                "linkToDefaultDomain": "[parameters('route_linkToDefaultDomain')[variables('filtered_route_indexes')[copyIndex()]]]",
                "cacheConfiguration": "[parameters('route_cacheConfig')[variables('filtered_route_indexes')[copyIndex()]].cacheConfiguration]",
                "ruleSets": "[variables('processedRuleSets')[copyIndex()]]"
            }
        }
    ]
}