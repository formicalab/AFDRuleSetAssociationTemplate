{
    "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
    "view": {
        "kind": "Form",
        "properties": {
            "title": "FrontDoor Ruleset Associations",
            "steps": [
                {
                    "name": "basics",
                    "label": "Basics",
                    "elements": [
                        {
                            "name": "introTextBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "[concat('Use this template to modify ruleset associations for <ul><li>FrontDoor profile: <b>', steps('basics').afdProfileSelector.name, '</b> (sku: ', steps('basics').afdProfile.sku.name, ')</li><li>Endpoint: <b>', steps('basics').afdEndpoint.name, '</b> (hostName: ', steps('basics').afdEndpoint.properties.hostName, ')</li><li>Routes: <b>', string(length(steps('basics').afdRoutes.transformed.routeIds)),  '</b></li><li>Available rulesets: <b>', string(length(steps('basics').afdRuleSets.value))  ,'</b></li></ul>')]"
                            }
                        },
                        {
                            "name": "resourceScope",
                            "type": "Microsoft.Common.ResourceScope",
                            "instanceDetailsLabel": "Specify the subscription and resource group of the Front Door profile",
                            "globalResource": true,
                            "resourceGroup": {
                                "allowExisting": true
                            }
                        },
                        {
                            "name": "afdProfileSelector",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Select the Front Door (Std/Premium) Profile from above subscription:",
                            "resourceType": "Microsoft.Cdn/profiles",
                            "scope": {
                                "subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
                            },
                            "constraints": {
                                "required": true
                            }
                        },
                        {
                            "name": "afdProfile",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdProfileSelector.id, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdEndpoints",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdProfileSelector.id, '/afdEndpoints?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdEndpointSelector",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Select the desired endpoint in the above Front Door",
                            "filter": true,
                            "constraints": {
                                "allowedValues": "[map(steps('basics').afdEndpoints.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\",\"description\":\"', item.properties.hostName, '\"}')))]",
                                "required": true
                            },
                            "visible": true
                        },
                        {
                            "name": "afdEndpoint",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdEndpointSelector, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdRuleSets",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdProfile.id, '/ruleSets?api-version=2025-04-15')]",
                                "transforms": {
                                    "list": "value|[*].{label:name, value:id}",
                                    "listWithRemove": "[value|[*].{label:name, value:id}, [{label: '---', value: '---'}]][]"
                                }
                            }
                        },
                        {
                            "name": "noRoutesWarning",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[equals(length(coalesce(steps('basics').afdRoutes.value, [])), 0)]",
                            "options": {
                                "style": "Warning",
                                "text": "The selected endpoint has <b>no routes</b>. Select a different endpoint or create routes first."
                            }
                        },
                        {
                            "name": "afdRoutes",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdEndpoint.id, '/routes?api-version=2025-04-15')]",
                                "transforms": {
                                    "routeList": "[value|[*].{label:name, value:id, ruleSetIds:properties.ruleSets}][]",
                                    "currentRuleSets": "[value|[*].properties.ruleSets][]",
                                    "originGroups": "[value|[*].properties.originGroup.id][]",
                                    "customDomains": "[value|[*].properties.customDomains][]",
                                    "patterns": "[value|[*].properties.patternsToMatch][]",
                                    "protocols": "[value|[*].properties.supportedProtocols][]",
                                    "httpsRedirect": "[value|[*].properties.httpsRedirect][]",
                                    "forwardingProtocol": "[value|[*].properties.forwardingProtocol][]",
                                    "enabledState": "[value|[*].properties.enabledState][]",
                                    "cacheConfiguration": "value|[*].{cacheConfiguration: properties.cacheConfiguration}",
                                    "routeIds": "[value|[*].id][]"
                                }
                            }
                        },
                        {
                            "name": "loadBalancingStatistics",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": true,
                            "options": {
                                "text": "[concat('📊 <b>Route Statistics:</b> ', string(length(filter(steps('basics').afdRoutes.transformed.routeList, (r) => greater(length(filter(r.ruleSetIds, (rs) => startsWith(toLower(last(split(rs.id, '/'))), 'bilanciamento'))), 0)))), ' of ', string(length(steps('basics').afdRoutes.value)), ' routes have load balancing rulesets configured')]"
                            }
                        }
                    ]
                },
                {
                    "name": "associations",
                    "label": "Associations",
                    "elements": [
                        {
                            "name": "noLoadBalancingRulesetsInfo",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[equals(length(filter(steps('basics').afdRuleSets.transformed.listWithRemove, (item) => startsWith(toLower(item.label), 'bilanciamento'))), 0)]",
                            "options": {
                                "style": "Warning",
                                "text": "No load balancing rulesets found in this Front Door profile. You can only remove existing load balancing associations by selecting '---'."
                            }
                        },
                        {
                            "name": "warningMessage",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "This operation will manage the association of rulesets used for load balancing (names start with <b>Bilanciamento</b>) for the selected routes.<br/><br/><b>Choices:</b><br/>• Select a load balancing ruleset: all existing load balancing rulesets will be removed and replaced with your selection. Other rulesets will be preserved.<br/>• Select '---': all load balancing rulesets will be removed. Other rulesets will be preserved."
                            }
                        },
                        {
                            "name": "ddRuleset",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Load balancing ruleset to associate or '---' to remove load balancing rulesets associated with the routes:",
                            "placeholder": "Only load balancing rulesets are shown",
                            "filter": true,
                            "filterPlaceholder": "Filter items ...",
                            "constraints": {
                                "required": true,
                                "allowedValues": "[filter(steps('basics').afdRuleSets.transformed.listWithRemove, (item) => or(equals(item.value, '---'), startsWith(toLower(item.label), 'bilanciamento')))]"
                            }
                        },
                        {
                            "name": "currentSelectionSummary",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": "[not(empty(steps('associations').ddRuleset))]",
                            "options": {
                                "text": "[concat('✓ <b>Selected:</b> ', if(equals(steps('associations').ddRuleset, '---'), 'Remove all load balancing rulesets', concat('Replace with <b>', last(split(steps('associations').ddRuleset, '/')), '</b>')))]"
                            }
                        },
                        {
                            "name": "selectedRoutes",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Routes to associate the rulesets with",
                            "multiselect": true,
                            "selectAll": true,
                            "filter": true,
                            "filterPlaceholder": "Filter items ...",
                            "multiLine": true,
                            "defaultDescription": "No ruleset associated",
                            "constraints": {
                                "allowedValues": "[map(steps('basics').afdRoutes.transformed.routeList, (item) => parse(concat('{\"label\":\"', item.label, '\",\"value\":\"', item.value, '\",\"description\":\"', if(empty(item.ruleSetIds), 'No rulesets', if(greater(length(filter(item.ruleSetIds, (rs) => startsWith(toLower(last(split(rs.id, '/'))), 'bilanciamento'))), 0), concat(string(length(item.ruleSetIds)), ' rulesets (has load balancing)'), if(equals(length(item.ruleSetIds), 1), '1 ruleset', concat(string(length(item.ruleSetIds)), ' rulesets')))), '\"}')))]",
                                "required": true
                            },
                            "visible": true
                        }
                    ]
                },
                {
                    "name": "review",
                    "label": "Review Changes",
                    "elements": [
                        {
                            "name": "reviewInfo",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "Review the changes that will be applied. This deployment will affect the selected routes."
                            }
                        },
                        {
                            "name": "operationSummary",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": true,
                            "options": {
                                "text": "[if(equals(steps('associations').ddRuleset, '---'), '🗑️ <b>Operation: REMOVE</b> all load balancing rulesets', concat('🔄 <b>Operation: REPLACE</b> load balancing rulesets with <b>', last(split(steps('associations').ddRuleset, '/')), '</b>'))]"
                            }
                        },
                        {
                            "name": "impactSummary",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[greater(length(steps('associations').selectedRoutes), 0)]",
                            "options": {
                                "style": "Warning",
                                "text": "[concat('<b>Impact:</b><ul><li><b>Preserved:</b> All non-load balancing rulesets will remain in their current positions</li><li><b>Modified:</b> Load balancing rulesets will be ', if(equals(steps('associations').ddRuleset, '---'), 'removed', 'replaced in their current positions'), '</li><li><b>Routes affected:</b> ', string(length(steps('associations').selectedRoutes)), '. The list will be provided in the final page of this wizard</li></ul>')]"
                            }
                        },
                        {
                            "name": "detailsNote",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "<b>Note:</b> After deployment, navigate to the Front Door resource in Azure Portal to view the updated ruleset associations for each route. The changes will be visible in the Routes blade under each endpoint."
                            }
                        }
                    ]
                }
            ]
        },
        "outputs": {
            "parameters": {
                "location": "[steps('basics').resourceScope.location.name]",
                "afd_profile_id": "[steps('basics').afdProfile.id]",
                "afd_endpoint_id": "[steps('basics').afdEndpoint.id]",
                "selected_ruleset_id": "[steps('associations').ddRuleset]",
                "selected_routes": "[steps('associations').selectedRoutes]",
                "route_originGroups": "[steps('basics').afdRoutes.transformed.originGroups]",
                "route_customDomains": "[steps('basics').afdRoutes.transformed.customDomains]",
                "route_patterns": "[steps('basics').afdRoutes.transformed.patterns]",
                "route_protocols": "[steps('basics').afdRoutes.transformed.protocols]",
                "route_httpsRedirect": "[steps('basics').afdRoutes.transformed.httpsRedirect]",
                "route_forwardingProto": "[steps('basics').afdRoutes.transformed.forwardingProtocol]",
                "route_enabledState": "[steps('basics').afdRoutes.transformed.enabledState]",
                "route_cacheConfig": "[steps('basics').afdRoutes.transformed.cacheConfiguration]",
                "route_currentRuleSets": "[steps('basics').afdRoutes.transformed.currentRuleSets]",
                "all_route_ids": "[steps('basics').afdRoutes.transformed.routeIds]"
            },
            "kind": "ResourceGroup",
            "location": "[steps('basics').resourceScope.location.name]",
            "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]"
        }
    }
}