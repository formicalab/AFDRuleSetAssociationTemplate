{
    "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
    "view": {
        "kind": "Form",
        "properties": {
            "title": "FrontDoor Ruleset Associations",
            "steps": [
                {
                    "name": "basics",
                    "label": "Basics",
                    "elements": [
                        {
                            "name": "introTextBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "Use this template to modify load balancing for Front Door routes across two AFD profiles. Select the subscription containing your AFD profiles, then configure AFD A and AFD B in the following tabs."
                            }
                        },
                        {
                            "name": "resourceScope",
                            "type": "Microsoft.Common.ResourceScope",
                            "instanceDetailsLabel": "Select the subscription containing your AFD profiles",
                            "globalResource": true,
                            "resourceGroup": {
                                "allowExisting": true
                            }
                        }
                    ]
                },
                {
                    "name": "afdABasics",
                    "label": "AFD A - Basics",
                    "elements": [
                        {
                            "name": "afdAInfoBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "[concat('<b>AFD A Configuration</b><br/>This AFD follows the <b>n-routes-1-ruleset</b> logic: apply a single selected ruleset to multiple selected routes.<br/><br/><i>Leave empty to skip AFD A configuration.</i><br/><br/>Use this template to modify ruleset associations for <ul><li>FrontDoor profile: <b>', steps('afdABasics').afdAProfileSelector.name, '</b> (sku: ', steps('afdABasics').afdAProfile.sku.name, ')</li><li>Endpoint: <b>', steps('afdABasics').afdAEndpoint.name, '</b> (hostName: ', steps('afdABasics').afdAEndpoint.properties.hostName, ')</li><li>📊 <b>Routes:</b> ', string(length(filter(steps('afdABasics').afdARoutes.transformed.routeList, (r) => greater(length(filter(r.ruleSetIds, (rs) => startsWith(toLower(last(split(rs.id, '/'))), 'bilanciamento'))), 0)))), ' of ', string(length(steps('afdABasics').afdARoutes.value)), ' have load balancing rulesets configured</li><li>📊 <b>Available rulesets:</b> ', string(length(filter(steps('afdABasics').afdARuleSets.value, (item) => startsWith(toLower(item.name), 'bilanciamento')))), ' load balancing of <b>', string(length(steps('afdABasics').afdARuleSets.value)), '</b> total</li></ul>')]"
                            }
                        },
                        {
                            "name": "afdAProfileSelector",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Select the Front Door (Std/Premium) Profile for AFD A:",
                            "resourceType": "Microsoft.Cdn/profiles",
                            "scope": {
                                "subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
                            },
                            "constraints": {
                                "required": false
                            }
                        },
                        {
                            "name": "afdAProfile",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdABasics').afdAProfileSelector.id, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdAEndpoints",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdABasics').afdAProfileSelector.id, '/afdEndpoints?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdAEndpointSelector",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Select the desired endpoint in AFD A",
                            "filter": true,
                            "constraints": {
                                "allowedValues": "[map(steps('afdABasics').afdAEndpoints.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\",\"description\":\"', item.properties.hostName, '\"}')))]",
                                "required": false
                            },
                            "visible": true
                        },
                        {
                            "name": "afdAEndpoint",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdABasics').afdAEndpointSelector, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdARuleSets",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdABasics').afdAProfile.id, '/ruleSets?api-version=2025-04-15')]",
                                "transforms": {
                                    "list": "value|[*].{label:name, value:id}",
                                    "listWithRemove": "[value|[*].{label:name, value:id}, [{label: '---', value: '---'}]][]"
                                }
                            }
                        },
                        {
                            "name": "afdANoRoutesWarning",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[equals(length(coalesce(steps('afdABasics').afdARoutes.value, [])), 0)]",
                            "options": {
                                "style": "Warning",
                                "text": "The selected endpoint has <b>no routes</b>. Select a different endpoint or create routes first."
                            }
                        },
                        {
                            "name": "afdARoutes",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdABasics').afdAEndpoint.id, '/routes?api-version=2025-04-15')]",
                                "transforms": {
                                    "routeList": "[value|[*].{label:name, value:id, ruleSetIds:properties.ruleSets}][]",
                                    "currentRuleSets": "[value|[*].properties.ruleSets][]",
                                    "originGroups": "[value|[*].properties.originGroup.id][]",
                                    "originPath": "[value|[*].properties.originPath][]",
                                    "customDomains": "[value|[*].properties.customDomains][]",
                                    "patterns": "[value|[*].properties.patternsToMatch][]",
                                    "protocols": "[value|[*].properties.supportedProtocols][]",
                                    "httpsRedirect": "[value|[*].properties.httpsRedirect][]",
                                    "forwardingProtocol": "[value|[*].properties.forwardingProtocol][]",
                                    "enabledState": "[value|[*].properties.enabledState][]",
                                    "linkToDefaultDomain": "[value|[*].properties.linkToDefaultDomain][]",
                                    "cacheConfiguration": "value|[*].properties.cacheConfiguration",
                                    "routeIds": "[value|[*].id][]"
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "afdAAssociations",
                    "label": "AFD A - Associations",
                    "elements": [
                        {
                            "name": "afdASkippedInfo",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[empty(steps('afdABasics').afdAEndpointSelector)]",
                            "options": {
                                "style": "Warning",
                                "text": "<b>AFD A not configured</b><br/>No endpoint was selected for AFD A. Go back to the previous step if you want to configure AFD A."
                            }
                        },
                        {
                            "name": "afdANoLoadBalancingRulesetsInfo",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[and(not(empty(steps('afdABasics').afdAEndpointSelector)), equals(length(filter(steps('afdABasics').afdARuleSets.transformed.listWithRemove, (item) => startsWith(toLower(item.label), 'bilanciamento'))), 0))]",
                            "options": {
                                "style": "Warning",
                                "text": "No load balancing rulesets found in this Front Door profile. You can only remove existing load balancing associations by selecting '---'."
                            }
                        },
                        {
                            "name": "afdANoLoadBalancingRoutesWarning",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[and(not(empty(steps('afdABasics').afdAEndpointSelector)), equals(length(filter(steps('afdABasics').afdARoutes.transformed.routeList, (item) => greater(length(filter(item.ruleSetIds, (rs) => startsWith(toLower(last(split(rs.id, '/'))), 'bilanciamento'))), 0))), 0))]",
                            "options": {
                                "style": "Warning",
                                "text": "No routes currently have load balancing rulesets associated. You must first associate load balancing rulesets to routes before using this template. Only routes with existing load balancing rulesets can be modified."
                            }
                        },
                        {
                            "name": "afdAWarningMessage",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[not(empty(steps('afdABasics').afdAEndpointSelector))]",
                            "options": {
                                "style": "Info",
                                "text": "[concat('📊 <b>Routes:</b> ', string(length(filter(steps('afdABasics').afdARoutes.transformed.routeList, (r) => greater(length(filter(r.ruleSetIds, (rs) => startsWith(toLower(last(split(rs.id, '/'))), 'bilanciamento'))), 0)))), ' of ', string(length(steps('afdABasics').afdARoutes.value)), ' have load balancing rulesets configured<br/>📊 <b>Available rulesets:</b> ', string(length(filter(steps('afdABasics').afdARuleSets.value, (item) => startsWith(toLower(item.name), 'bilanciamento')))), ' load balancing of ', string(length(steps('afdABasics').afdARuleSets.value)), ' total<br/><br/>This operation will manage load balancing rulesets (names start with <b>Bilanciamento</b>) for routes that already have them configured.<br/><br/><b>Choices:</b><br/>• Select a load balancing ruleset: existing load balancing rulesets will be replaced with your selection. Other rulesets will be preserved.<br/>• Select \\'---\\': all load balancing rulesets will be removed. Other rulesets will be preserved.<br/><br/><b>Note:</b> Only routes with existing load balancing rulesets are shown in the dropdown below.')]"
                            }
                        },
                        {
                            "name": "afdARulesetSelector",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Load balancing ruleset to associate or '---' to remove load balancing rulesets associated with the routes:",
                            "placeholder": "Only load balancing rulesets are shown",
                            "filter": true,
                            "filterPlaceholder": "Filter items ...",
                            "visible": "[not(empty(steps('afdABasics').afdAEndpointSelector))]",
                            "constraints": {
                                "required": "[not(empty(steps('afdABasics').afdAEndpointSelector))]",
                                "allowedValues": "[filter(steps('afdABasics').afdARuleSets.transformed.listWithRemove, (item) => or(equals(item.value, '---'), startsWith(toLower(item.label), 'bilanciamento')))]"
                            }
                        },
                        {
                            "name": "afdACurrentSelectionSummary",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": "[and(not(empty(steps('afdABasics').afdAEndpointSelector)), not(empty(steps('afdAAssociations').afdARulesetSelector)))]",
                            "options": {
                                "text": "[concat('✓ <b>Selected:</b> ', if(equals(steps('afdAAssociations').afdARulesetSelector, '---'), 'Remove all load balancing rulesets', concat('Replace with <b>', last(split(steps('afdAAssociations').afdARulesetSelector, '/')), '</b>')))]"
                            }
                        },
                        {
                            "name": "afdARouteSelector",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Routes to associate the rulesets with",
                            "multiselect": true,
                            "selectAll": true,
                            "filter": true,
                            "filterPlaceholder": "Filter items ...",
                            "multiLine": true,
                            "defaultDescription": "Route with load balancing",
                            "constraints": {
                                "allowedValues": "[map(filter(steps('afdABasics').afdARoutes.transformed.routeList, (item) => greater(length(filter(item.ruleSetIds, (rs) => startsWith(toLower(last(split(rs.id, '/'))), 'bilanciamento'))), 0)), (item) => parse(concat('{\"label\":\"', item.label, '\",\"value\":\"', item.value, '\",\"description\":\"', concat(string(length(item.ruleSetIds)), ' rulesets (has load balancing)'), '\"}')))]",
                                "required": "[not(empty(steps('afdABasics').afdAEndpointSelector))]"
                            },
                            "visible": "[not(empty(steps('afdABasics').afdAEndpointSelector))]"
                        }
                    ]
                },
                {
                    "name": "afdBBasics",
                    "label": "AFD B - Basics",
                    "elements": [
                        {
                            "name": "afdBInfoBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "<b>AFD B Configuration</b><br/>This AFD follows the <b>n-routes-n-rulesets</b> logic: each route gets its own Bilanciamento ruleset based on the selected load balancing percentage."
                            }
                        },
                        {
                            "name": "afdBProfileSelector",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Select the Front Door (Std/Premium) Profile for AFD B:",
                            "resourceType": "Microsoft.Cdn/profiles",
                            "scope": {
                                "subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
                            },
                            "constraints": {
                                "required": false
                            }
                        },
                        {
                            "name": "afdBProfile",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdBBasics').afdBProfileSelector.id, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdBEndpoints",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdBBasics').afdBProfileSelector.id, '/afdEndpoints?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdBEndpointSelector",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Select the desired endpoint in AFD B",
                            "filter": true,
                            "constraints": {
                                "allowedValues": "[map(steps('afdBBasics').afdBEndpoints.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\",\"description\":\"', item.properties.hostName, '\"}')))]",
                                "required": false
                            },
                            "visible": true
                        },
                        {
                            "name": "afdBEndpoint",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdBBasics').afdBEndpointSelector, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdBRuleSets",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdBBasics').afdBProfile.id, '/ruleSets?api-version=2025-04-15')]",
                                "transforms": {
                                    "list": "value|[*].{label:name, value:id}"
                                }
                            }
                        },
                        {
                            "name": "afdBRoutes",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('afdBBasics').afdBEndpoint.id, '/routes?api-version=2025-04-15')]",
                                "transforms": {
                                    "list": "value|[*].{label:name, value:id}",
                                    "routeToList": "value|[?starts_with(name, 'route-to-')].name",
                                    "currentRuleSets": "[value|[*].properties.ruleSets][]",
                                    "originGroups": "[value|[*].properties.originGroup.id][]",
                                    "originPath": "value|[*].properties.originPath",
                                    "customDomains": "[value|[*].properties.customDomains][]",
                                    "patterns": "[value|[*].properties.patternsToMatch][]",
                                    "protocols": "[value|[*].properties.supportedProtocols][]",
                                    "httpsRedirect": "[value|[*].properties.httpsRedirect][]",
                                    "forwardingProtocol": "[value|[*].properties.forwardingProtocol][]",
                                    "enabledState": "[value|[*].properties.enabledState][]",
                                    "linkToDefaultDomain": "[value|[*].properties.linkToDefaultDomain][]",
                                    "cacheConfiguration": "value|[*].properties.cacheConfiguration",
                                    "routeIds": "[value|[*].id][]"
                                }
                            }
                        },
                        {
                            "name": "afdBSummaryInfoBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[not(empty(steps('afdBBasics').afdBEndpointSelector))]",
                            "options": {
                                "style": "Info",
                                "text": "[concat('✓ <b>AFD B Configuration Summary:</b><ul><li>FrontDoor profile: <b>', steps('afdBBasics').afdBProfileSelector.name, '</b> (sku: ', coalesce(steps('afdBBasics').afdBProfile.sku.name, 'N/A'), ')</li><li>Endpoint: <b>', coalesce(steps('afdBBasics').afdBEndpoint.name, 'N/A'), '</b> (hostName: ', coalesce(steps('afdBBasics').afdBEndpoint.properties.hostName, 'N/A'), ')</li><li>📊 <b>Routes (route-to-*):</b> ', string(length(filter(coalesce(steps('afdBBasics').afdBRoutes.value, parse('[]')), (r) => startsWith(r.name, 'route-to-')))), ' total, ', string(length(filter(coalesce(steps('afdBBasics').afdBRoutes.value, parse('[]')), (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))))), ' with Bilanciamento</li><li>📋 <b>Bilanciamento Rulesets:</b> ', string(length(filter(coalesce(steps('afdBBasics').afdBRuleSets.value, parse('[]')), (rs) => if(and(startsWith(rs.name, 'Bilanciamento'), greater(length(rs.name), 13)), and(contains(rs.name, 'SiteA'), contains(rs.name, 'SiteB')), false)))), ' found</li></ul>')]"
                            }
                        }
                    ]
                },
                {
                    "name": "afdBAssociations",
                    "label": "AFD B - Associations",
                    "elements": [
                        {
                            "name": "afdBSkippedInfo",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[empty(steps('afdBBasics').afdBEndpointSelector)]",
                            "options": {
                                "style": "Warning",
                                "text": "<b>AFD B not configured</b><br/>No endpoint was selected for AFD B. Go back to the previous step if you want to configure AFD B."
                            }
                        },
                        {
                            "name": "afdBAssociationsHeader",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[not(empty(steps('afdBBasics').afdBEndpointSelector))]",
                            "options": {
                                "style": "Info",
                                "text": "<b>AFD B Load Balancing Configuration</b><br/>Select the load balancing percentage to apply to AFD B routes."
                            }
                        },
                        {
                            "name": "ddLoadBalancing",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Select load balancing percentage (Site A / Site B):",
                            "placeholder": "Choose percentage distribution",
                            "filter": true,
                            "filterPlaceholder": "Filter items ...",
                            "visible": "[not(empty(steps('afdBBasics').afdBEndpointSelector))]",
                            "constraints": {
                                "required": "[not(empty(steps('afdBBasics').afdBEndpointSelector))]",
                                "allowedValues": [
                                    {"label": "SiteA0SiteB100", "value": "SiteA0SiteB100"},
                                    {"label": "SiteA10SiteB90", "value": "SiteA10SiteB90"},
                                    {"label": "SiteA20SiteB80", "value": "SiteA20SiteB80"},
                                    {"label": "SiteA30SiteB70", "value": "SiteA30SiteB70"},
                                    {"label": "SiteA40SiteB60", "value": "SiteA40SiteB60"},
                                    {"label": "SiteA50SiteB50", "value": "SiteA50SiteB50"},
                                    {"label": "SiteA60SiteB40", "value": "SiteA60SiteB40"},
                                    {"label": "SiteA70SiteB30", "value": "SiteA70SiteB30"},
                                    {"label": "SiteA80SiteB20", "value": "SiteA80SiteB20"},
                                    {"label": "SiteA90SiteB10", "value": "SiteA90SiteB10"},
                                    {"label": "SiteA100SiteB0", "value": "SiteA100SiteB0"}
                                ]
                            }
                        },
                        {
                            "name": "afdBCurrentSelectionSummary",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[and(not(empty(steps('afdBBasics').afdBEndpointSelector)), not(empty(steps('afdBAssociations').ddLoadBalancing)))]",
                            "options": {
                                "style": "Info",
                                "text": "[concat('✓ <b>Load Balancing Selected:</b> ', steps('afdBAssociations').ddLoadBalancing, '<br/><br/><b>Routes that will be updated (', string(length(filter(coalesce(steps('afdBBasics').afdBRoutes.value, parse('[]')), (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))))), ' routes):</b><br/>', replace(replace(replace(string(map(filter(coalesce(steps('afdBBasics').afdBRoutes.value, parse('[]')), (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))), (r) => r.name)), '[\"', '• '), '\",\"', '<br/>• '), '\"]', ''), '<br/><br/><i>Only routes matching <b>route-to-*</b> pattern AND already associated with a Bilanciamento ruleset are shown.</i><br/><br/><b>Ruleset Mapping Convention:</b><br/>• route-to-<i>xxx</i> → Bilanciamento<i>Xxx</i>', steps('afdBAssociations').ddLoadBalancing)]"
                            }
                        },
                        {
                            "name": "validationCheck",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[and(not(empty(steps('afdBBasics').afdBEndpointSelector)), and(not(empty(steps('afdBAssociations').ddLoadBalancing)), greater(length(filter(map(filter(steps('afdBBasics').afdBRoutes.value, (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))), (r) => r.name), (routeName) => not(contains(string(map(steps('afdBBasics').afdBRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('afdBAssociations').ddLoadBalancing)))))), 0)))]",
                            "options": {
                                "style": "Error",
                                "text": "[concat('<b>ERROR: Missing Rulesets Detected!</b><br/><br/>One or more required rulesets do not exist in the Front Door profile.<br/><br/><b>Missing rulesets (', string(length(filter(map(filter(steps('afdBBasics').afdBRoutes.value, (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))), (r) => r.name), (routeName) => not(contains(string(map(steps('afdBBasics').afdBRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('afdBAssociations').ddLoadBalancing))))))), '):</b><br/>', replace(replace(replace(string(map(filter(map(filter(steps('afdBBasics').afdBRoutes.value, (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))), (r) => r.name), (routeName) => not(contains(string(map(steps('afdBBasics').afdBRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('afdBAssociations').ddLoadBalancing))))), (routeName) => concat('Bilanciamento', toUpper(first(replace(routeName, 'route-to-', ''))), skip(replace(routeName, 'route-to-', ''), 1), steps('afdBAssociations').ddLoadBalancing))), '[\"', '• '), '\",\"', '<br/>• '), '\"]', ''), '<br/><br/>Please ensure all required Bilanciamento rulesets exist before proceeding with deployment.<br/><br/><i>Note: Ruleset names are case-insensitive (e.g., BilanciamentoAzureSiteA30SiteB70 and Bilanciamentoazuresitea30siteb70 are equivalent).</i>')]"
                            }
                        },
                        {
                            "name": "deploymentBlocker",
                            "type": "Microsoft.Common.TextBox",
                            "label": "Validation Status",
                            "defaultValue": "DEPLOYMENT BLOCKED - Required rulesets are missing",
                            "visible": "[and(not(empty(steps('afdBBasics').afdBEndpointSelector)), and(not(empty(steps('afdBAssociations').ddLoadBalancing)), greater(length(filter(map(filter(steps('afdBBasics').afdBRoutes.value, (r) => and(startsWith(r.name, 'route-to-'), contains(string(r.properties.ruleSets), 'Bilanciamento'))), (r) => r.name), (routeName) => not(contains(string(map(steps('afdBBasics').afdBRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('afdBAssociations').ddLoadBalancing)))))), 0)))]",
                            "constraints": {
                                "required": true,
                                "validations": [
                                    {
                                        "isValid": "[equals(1, 0)]",
                                        "message": "Deployment blocked: Required rulesets are missing. Please create the missing Bilanciamento rulesets before proceeding."
                                    }
                                ]
                            }
                        },
                        {
                            "name": "noEligibleRoutesWarning",
                            "type": "Microsoft.Common.InfoBox",
