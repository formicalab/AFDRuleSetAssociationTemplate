{
    "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
    "view": {
        "kind": "Form",
        "properties": {
            "title": "FrontDoor Ruleset Associations",
            "steps": [
                {
                    "name": "basics",
                    "label": "Basics",
                    "elements": [
                        {
                            "name": "introTextBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": true,
                            "options": {
                                "style": "Info",
                                "text": "Use this template to modify load balancing for Front Door routes. Select a profile and endpoint to continue."
                            }
                        },
                        {
                            "name": "resourceScope",
                            "type": "Microsoft.Common.ResourceScope",
                            "instanceDetailsLabel": "Specify the subscription and resource group of the Front Door profile",
                            "globalResource": true,
                            "resourceGroup": {
                                "allowExisting": true
                            }
                        },
                        {
                            "name": "afdProfileSelector",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Select the Front Door (Std/Premium) Profile from above subscription:",
                            "resourceType": "Microsoft.Cdn/profiles",
                            "scope": {
                                "subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
                            },
                            "constraints": {
                                "required": true
                            }
                        },
                        {
                            "name": "afdProfile",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdProfileSelector.id, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdEndpoints",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdProfileSelector.id, '/afdEndpoints?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdEndpointSelector",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Select the desired endpoint in the above Front Door",
                            "filter": true,
                            "constraints": {
                                "allowedValues": "[map(steps('basics').afdEndpoints.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\",\"description\":\"', item.properties.hostName, '\"}')))]",
                                "required": true
                            },
                            "visible": true
                        },
                        {
                            "name": "afdEndpoint",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdEndpointSelector, '?api-version=2025-04-15')]"
                            }
                        },
                        {
                            "name": "afdRuleSets",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdProfile.id, '/ruleSets?api-version=2025-04-15')]",
                                "transforms": {
                                    "list": "value|[*].{label:name, value:id}"
                                }
                            }
                        },
                        {
                            "name": "afdRoutes",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').afdEndpointSelector, '/routes?api-version=2025-04-15')]",
                                "transforms": {
                                    "list": "value|[*].{label:name, value:id}",
                                    "routeToList": "value|[?starts_with(name, 'route-to-')].name",
                                    "currentRuleSets": "[value|[*].properties.ruleSets][]",
                                    "originGroups": "[value|[*].properties.originGroup.id][]",
                                    "originPath": "value|[*].properties.originPath",
                                    "customDomains": "[value|[*].properties.customDomains][]",
                                    "patterns": "[value|[*].properties.patternsToMatch][]",
                                    "protocols": "[value|[*].properties.supportedProtocols][]",
                                    "httpsRedirect": "[value|[*].properties.httpsRedirect][]",
                                    "forwardingProtocol": "[value|[*].properties.forwardingProtocol][]",
                                    "enabledState": "[value|[*].properties.enabledState][]",
                                    "linkToDefaultDomain": "[value|[*].properties.linkToDefaultDomain][]",
                                    "cacheConfiguration": "value|[*].{cacheConfiguration: properties.cacheConfiguration}",
                                    "routeIds": "[value|[*].id][]"
                                }
                            }
                        },
                        {
                            "name": "summaryInfoBlock",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[not(empty(steps('basics').afdEndpointSelector))]",
                            "options": {
                                "style": "Info",
                                "text": "[concat('✓ <b>Configuration Summary:</b><ul><li>FrontDoor profile: <b>', steps('basics').afdProfileSelector.name, '</b> (sku: ', steps('basics').afdProfile.sku.name, ')</li><li>Endpoint: <b>', steps('basics').afdEndpoint.name, '</b> (hostName: ', steps('basics').afdEndpoint.properties.hostName, ')</li><li>📊 <b>Routes (route-to-*):</b> ', string(length(filter(steps('basics').afdRoutes.transformed.list, (r) => startsWith(r.label, 'route-to-')))), ' found</li><li>📋 <b>Bilanciamento Rulesets:</b> ', string(length(filter(steps('basics').afdRuleSets.value, (rs) => if(and(startsWith(rs.name, 'Bilanciamento'), greater(length(rs.name), 13)), and(contains(rs.name, 'SiteA'), contains(rs.name, 'SiteB')), false)))), ' found</li></ul>')]"
                            }
                        }
                    ]
                },
                {
                    "name": "associations",
                    "label": "Associations",
                    "elements": [
                        {
                            "name": "ddLoadBalancing",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Select load balancing percentage (Site A / Site B):",
                            "placeholder": "Choose percentage distribution",
                            "filter": true,
                            "filterPlaceholder": "Filter items ...",
                            "constraints": {
                                "required": true,
                                "allowedValues": [
                                    {"label": "SiteA0SiteB100", "value": "SiteA0SiteB100"},
                                    {"label": "SiteA10SiteB90", "value": "SiteA10SiteB90"},
                                    {"label": "SiteA20SiteB80", "value": "SiteA20SiteB80"},
                                    {"label": "SiteA30SiteB70", "value": "SiteA30SiteB70"},
                                    {"label": "SiteA40SiteB60", "value": "SiteA40SiteB60"},
                                    {"label": "SiteA50SiteB50", "value": "SiteA50SiteB50"},
                                    {"label": "SiteA60SiteB40", "value": "SiteA60SiteB40"},
                                    {"label": "SiteA70SiteB30", "value": "SiteA70SiteB30"},
                                    {"label": "SiteA80SiteB20", "value": "SiteA80SiteB20"},
                                    {"label": "SiteA90SiteB10", "value": "SiteA90SiteB10"},
                                    {"label": "SiteA100SiteB0", "value": "SiteA100SiteB0"}
                                ]
                            }
                        },
                        {
                            "name": "currentSelectionSummary",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[not(empty(steps('associations').ddLoadBalancing))]",
                            "options": {
                                "style": "Info",
                                "text": "[concat('✓ <b>Load Balancing Selected:</b> ', steps('associations').ddLoadBalancing, '<br/><br/><b>Routes that will be updated (', string(length(steps('basics').afdRoutes.transformed.routeToList)), ' routes):</b><br/>', replace(replace(replace(string(steps('basics').afdRoutes.transformed.routeToList), '[\"', '• '), '\",\"', '<br/>• '), '\"]', ''), '<br/><br/><b>Ruleset Mapping Convention:</b><br/>• route-to-<i>xxx</i> → Bilanciamento<i>Xxx</i>', steps('associations').ddLoadBalancing)]"
                            }
                        },
                        {
                            "name": "validationCheck",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[and(not(empty(steps('associations').ddLoadBalancing)), greater(length(filter(steps('basics').afdRoutes.transformed.routeToList, (routeName) => not(contains(string(map(steps('basics').afdRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('associations').ddLoadBalancing)))))), 0))]",
                            "options": {
                                "style": "Error",
                                "text": "[concat('<b>ERROR: Missing Rulesets Detected!</b><br/><br/>One or more required rulesets do not exist in the Front Door profile.<br/><br/><b>Missing rulesets (', string(length(filter(steps('basics').afdRoutes.transformed.routeToList, (routeName) => not(contains(string(map(steps('basics').afdRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('associations').ddLoadBalancing))))))), '):</b><br/>', replace(replace(replace(string(map(filter(steps('basics').afdRoutes.transformed.routeToList, (routeName) => not(contains(string(map(steps('basics').afdRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('associations').ddLoadBalancing))))), (routeName) => concat('Bilanciamento', toUpper(first(replace(routeName, 'route-to-', ''))), skip(replace(routeName, 'route-to-', ''), 1), steps('associations').ddLoadBalancing))), '[\"', '• '), '\",\"', '<br/>• '), '\"]', ''), '<br/><br/>Please ensure all required Bilanciamento rulesets exist before proceeding with deployment.<br/><br/><i>Note: Ruleset names are case-insensitive (e.g., BilanciamentoAzureSiteA30SiteB70 and Bilanciamentoazuresitea30siteb70 are equivalent).</i>')]"
                            }
                        },
                        {
                            "name": "deploymentBlocker",
                            "type": "Microsoft.Common.TextBox",
                            "label": "Validation Status",
                            "defaultValue": "DEPLOYMENT BLOCKED - Required rulesets are missing",
                            "visible": "[and(not(empty(steps('associations').ddLoadBalancing)), greater(length(filter(steps('basics').afdRoutes.transformed.routeToList, (routeName) => not(contains(string(map(steps('basics').afdRuleSets.value, (rs) => toLower(rs.name))), toLower(concat('bilanciamento', replace(routeName, 'route-to-', ''), steps('associations').ddLoadBalancing)))))), 0))]",
                            "constraints": {
                                "required": true,
                                "validations": [
                                    {
                                        "isValid": "[equals(1, 0)]",
                                        "message": "Deployment blocked: Required rulesets are missing. Please create the missing Bilanciamento rulesets before proceeding."
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        "outputs": {
            "parameters": {
                "afd_profile_id": "[steps('basics').afdProfile.id]",
                "afd_endpoint_id": "[steps('basics').afdEndpoint.id]",
                "selected_load_balancing": "[steps('associations').ddLoadBalancing]",
                "afd_rulesets": "[steps('basics').afdRuleSets.value]",
                "route_names": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.name)]",
                "route_originGroups": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.originGroup.id)]",
                "route_originPath": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.originPath)]",
                "route_customDomains": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.customDomains)]",
                "route_patterns": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.patternsToMatch)]",
                "route_protocols": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.supportedProtocols)]",
                "route_httpsRedirect": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.httpsRedirect)]",
                "route_forwardingProto": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.forwardingProtocol)]",
                "route_enabledState": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.enabledState)]",
                "route_linkToDefaultDomain": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.linkToDefaultDomain)]",
                "route_cacheConfig": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.cacheConfiguration)]",
                "route_currentRuleSets": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.properties.ruleSets)]",
                "all_route_ids": "[map(filter(steps('basics').afdRoutes.value, (r) => startsWith(r.name, 'route-to-')), (r) => r.id)]"
            },
            "kind": "ResourceGroup",
            "location": "[steps('basics').resourceScope.location.name]",
            "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]"
        }
    }
}